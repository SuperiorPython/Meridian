MERIDIAN_ENV=dev
# SEC requires a descriptive User-Agent with contact info for EDGAR requests
MERIDIAN_SEC_USER_AGENT=Meridian Research your-email@example.com
MERIDIAN_CACHE_DIR=data/cache
MERIDIAN_DB_PATH=data/meridian.db
# Access key for the API; required whenever MERIDIAN_ENV is not "dev". Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MERIDIAN_API_TOKEN=
# Comma-separated frontend origins allowed by CORS
MERIDIAN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
